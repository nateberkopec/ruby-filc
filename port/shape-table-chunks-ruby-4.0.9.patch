+#ifdef __FILC__
+static struct rb_shape_chunk *
+shape_chunk_get_or_create(shape_id_t index)
+{
+    struct rb_shape_chunk *chunk = RUBY_ATOMIC_PTR_LOAD(rb_shape_tree.shape_chunks[index]);
+    if (!chunk) {
+        chunk = calloc(1, sizeof(*chunk));
+        if (!chunk) rb_memerror();
+        chunk->first_id = index * SHAPE_CHUNK_SIZE;
+        struct rb_shape_chunk *existing = RUBY_ATOMIC_PTR_CAS(rb_shape_tree.shape_chunks[index], NULL, chunk);
+        if (existing) {
+            free(chunk);
+            chunk = existing;
+        }
+    }
+    return chunk;
+}
+#endif
+
 static rb_shape_t *
 shape_alloc(void)
 {
     shape_id_t current, new_id;
+#ifdef __FILC__
+    struct rb_shape_chunk *chunk;
+#endif
 
     do {
         current = RUBY_ATOMIC_LOAD(rb_shape_tree.next_shape_id);
         if (current > MAX_SHAPE_ID) {
             return NULL;  // Out of shapes
         }
+#ifdef __FILC__
+        chunk = shape_chunk_get_or_create(current / SHAPE_CHUNK_SIZE);
+#endif
         new_id = current + 1;
     } while (current != RUBY_ATOMIC_CAS(rb_shape_tree.next_shape_id, current, new_id));
 
+#ifdef __FILC__
+    return &chunk->shapes[current % SHAPE_CHUNK_SIZE];
+#else
     return &rb_shape_tree.shape_list[current];
+#endif
 }
 
