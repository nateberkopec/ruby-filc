+        ary_clear_removed(ary, len, RARRAY_LEN(ary) - len);
         ARY_SET_LEN(ary, len);
         if (len * 2 < ARY_CAPA(ary) &&
             ARY_CAPA(ary) > ARY_DEFAULT_SIZE) {
@@ -4235,6 +4278,7 @@ rb_ary_delete_at(VALUE ary, long pos)
     RARRAY_PTR_USE(ary, ptr, {
         MEMMOVE(ptr+pos, ptr+pos+1, VALUE, len-pos-1);
     });
+    ary_clear_removed(ary, len - 1, 1);
     ARY_INCREASE_LEN(ary, -1);
     ary_verify(ary);
     return del;
@@ -4853,10 +4897,12 @@ rb_ary_clear(VALUE ary)
     rb_ary_modify_check(ary);
     if (ARY_SHARED_P(ary)) {
         rb_ary_unshare(ary);
+        ary_clear_object_storage(ary);
         FL_SET_EMBED(ary);
         ARY_SET_EMBED_LEN(ary, 0);
     }
     else {
+        ary_clear_removed(ary, 0, RARRAY_LEN(ary));
         ARY_SET_LEN(ary, 0);
         if (ARY_DEFAULT_SIZE * 2 < ARY_CAPA(ary)) {
             ary_resize_capa(ary, ARY_DEFAULT_SIZE * 2);
@@ -6452,9 +6498,11 @@ rb_ary_uniq_bang(VALUE ary)
         return Qnil;
     }
     rb_ary_modify_check(ary);
+    ary_clear_removed(ary, 0, RARRAY_LEN(ary));
     ARY_SET_LEN(ary, 0);
     if (ARY_SHARED_P(ary)) {
         rb_ary_unshare(ary);
+        ary_clear_object_storage(ary);
         FL_SET_EMBED(ary);
     }
     ary_resize_capa(ary, hash_size);
