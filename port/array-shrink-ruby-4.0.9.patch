             ARY_SET_CAPA(ary, new_capa);
@@ -4050,6 +4091,7 @@ select_bang_ensure(VALUE a)
                     MEMMOVE(ptr + i2, ptr + i1, VALUE, tail);
                 });
         }
+        ary_clear_removed(ary, i2 + tail, len - i2 - tail);
         ARY_SET_LEN(ary, i2 + tail);
     }
     return ary;
@@ -4119,6 +4161,7 @@ ary_resize_smaller(VALUE ary, long len)
 {
