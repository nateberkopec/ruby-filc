+/* Called with the registry lock held. While GC is disabled, reserve for every
+ * registered object, even during an explicit collection. Its completion can
+ * then restore roots without allocating or raising after unlinking a request. */
+static void
+registry_reserve_retained(struct filc_registry *registry, size_t needed)
+{
+    if (needed <= registry->retained_capa) return;
+    size_t capa = registry->retained_capa ? registry->retained_capa : 1024;
+    while (capa < needed) {
+        if (capa > SIZE_MAX / sizeof(VALUE) / 2) {
+            rb_native_mutex_unlock(&registry->lock);
+            rb_memerror();
+        }
+        capa *= 2;
+    }
+    VALUE *items = realloc(registry->retained, capa * sizeof(*items));
+    if (!items) {
+        rb_native_mutex_unlock(&registry->lock);
+        rb_memerror();
+    }
+    registry->retained = items;
+    registry->retained_capa = capa;
+}
