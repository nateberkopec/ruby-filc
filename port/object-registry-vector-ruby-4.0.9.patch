-        if (zweak_get(registry->items[i].weak)) registry->items[live++] = registry->items[i];
+        if (zweak_get(registry->items[i])) {
+            if (registry->retained) registry->retained[live] = registry->retained[i];
+            registry->items[live++] = registry->items[i];
+        }
+    }
+    if (live != registry->len) {
+        zmemset(registry->items + live, 0, (registry->len - live) * sizeof(*registry->items));
+        if (registry->retained) zmemset(registry->retained + live, 0, (registry->len - live) * sizeof(*registry->retained));
     }
-    if (live != registry->len) memset(registry->items + live, 0, (registry->len - live) * sizeof(*registry->items));
     registry->len = live;
 }
 
