diff --git a/shape.c b/shape.c
index 9003672..1a2e690 100644
--- a/shape.c
+++ b/shape.c
@@ -22,6 +22,15 @@
 
 #define REDBLACK_CACHE_SIZE (SHAPE_BUFFER_SIZE * 32)
 
+#ifdef __FILC__
+#define REDBLACK_CHUNK_SIZE 4096
+struct redblack_chunk {
+    redblack_id_t first_id;
+    redblack_node_t nodes[REDBLACK_CHUNK_SIZE];
+};
+static struct redblack_chunk *redblack_chunks[REDBLACK_CACHE_SIZE / REDBLACK_CHUNK_SIZE];
+#endif
+
 /* This depends on that the allocated memory by Ruby's allocator or
  * mmap is not located at an odd address. */
 #define SINGLE_CHILD_TAG 0x1
@@ -39,6 +48,16 @@ static ID id_object_id;
 #define BLACK 0x0
 #define RED 0x1
 
+static redblack_node_t *
+redblack_at(redblack_id_t index)
+{
+#ifdef __FILC__
+    return &redblack_chunks[index / REDBLACK_CHUNK_SIZE]->nodes[index % REDBLACK_CHUNK_SIZE];
+#else
+    return &rb_shape_tree.shape_cache[index];
+#endif
+}
+
 static redblack_node_t *
 redblack_left(redblack_node_t *node)
 {
@@ -47,7 +66,7 @@ redblack_left(redblack_node_t *node)
     }
     else {
         RUBY_ASSERT(node->l < rb_shape_tree.cache_size);
-        redblack_node_t *left = &rb_shape_tree.shape_cache[node->l - 1];
+        redblack_node_t *left = redblack_at(node->l - 1);
         return left;
     }
 }
@@ -60,7 +79,7 @@ redblack_right(redblack_node_t *node)
     }
     else {
         RUBY_ASSERT(node->r < rb_shape_tree.cache_size);
-        redblack_node_t *right = &rb_shape_tree.shape_cache[node->r - 1];
+        redblack_node_t *right = redblack_at(node->r - 1);
         return right;
     }
 }
@@ -118,9 +137,14 @@ redblack_id_for(redblack_node_t *node)
         return 0;
     }
     else {
+#ifdef __FILC__
+        struct redblack_chunk *chunk = zgetlower(node);
+        return chunk->first_id + (redblack_id_t)(node - chunk->nodes) + 1;
+#else
         redblack_node_t *redblack_nodes = rb_shape_tree.shape_cache;
         redblack_id_t id = (redblack_id_t)(node - redblack_nodes);
         return id + 1;
+#endif
     }
 }
 
@@ -135,8 +159,15 @@ redblack_new(char color, ID key, rb_shape_t *value, redblack_node_t *left, redbl
     RUBY_ASSERT(left == LEAF || left->key < key);
     RUBY_ASSERT(right == LEAF || right->key > key);
 
-    redblack_node_t *redblack_nodes = rb_shape_tree.shape_cache;
-    redblack_node_t *node = &redblack_nodes[(rb_shape_tree.cache_size)++];
+#ifdef __FILC__
+    redblack_id_t index = rb_shape_tree.cache_size / REDBLACK_CHUNK_SIZE;
+    if (!redblack_chunks[index]) {
+        struct redblack_chunk *chunk = ruby_xcalloc(1, sizeof(*chunk));
+        chunk->first_id = index * REDBLACK_CHUNK_SIZE;
+        redblack_chunks[index] = chunk;
+    }
+#endif
+    redblack_node_t *node = redblack_at(rb_shape_tree.cache_size++);
     node->key = key;
     node->value = (rb_shape_t *)((uintptr_t)value | color);
     node->l = redblack_id_for(left);
@@ -1567,7 +1598,7 @@ Init_default_shapes(void)
 
     id_object_id = rb_make_internal_id();
 
-#ifdef HAVE_MMAP
+#if defined(HAVE_MMAP) && !defined(__FILC__)
     size_t shape_cache_mmap_size = rb_size_mul_or_raise(REDBLACK_CACHE_SIZE, sizeof(redblack_node_t), rb_eRuntimeError);
     rb_shape_tree.shape_cache = (redblack_node_t *)mmap(NULL, shape_cache_mmap_size,
                          PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
