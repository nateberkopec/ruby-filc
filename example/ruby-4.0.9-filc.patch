+static struct filc_final_box *
+final_box_for(struct objspace *objspace, VALUE obj)
+{
+    struct filc_final_box *box = object_fields(obj)->finalizer;
+    if (!box) {
+        box = zgc_finq_alloc(objspace->finalizer_queue, sizeof(struct filc_final_box));
+        box->object = obj;
+        box->table = Qnil;
+        object_fields(obj)->finalizer = box;
+    }
+    return box;
+}
