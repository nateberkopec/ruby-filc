+static bool
+finalizable_type_p(uintptr_t flags)
+{
+    return (flags & RUBY_T_MASK) == T_DATA || (flags & RUBY_T_MASK) == T_FILE;
+}
+
+static void
+registry_compact(struct filc_registry *registry)
+{
+    size_t live = 0;
+    for (size_t i = 0; i < registry->len; i++) {
+        if (zweak_get(registry->items[i].weak)) registry->items[live++] = registry->items[i];
+    }
+    if (live != registry->len) memset(registry->items + live, 0, (registry->len - live) * sizeof(*registry->items));
+    registry->len = live;
+}
+
+static void
+registry_trim(struct filc_registry *registry)
+{
+    rb_native_mutex_lock(&registry->lock);
+    if (!registry->iterating) {
+        registry_compact(registry);
+        if (registry->capa > 1024 && registry->len < registry->capa / 4) {
+            size_t capa = registry->len > 512 ? registry->len * 2 : 1024;
+            struct filc_registry_entry *items = realloc(registry->items, capa * sizeof(*items));
+            if (!items) {
+                rb_native_mutex_unlock(&registry->lock);
+                rb_memerror();
+            }
+            registry->items = items;
+            registry->capa = capa;
+        }
+    }
+    rb_native_mutex_unlock(&registry->lock);
+}
+
+static void
+registry_add(struct filc_registry *registry, VALUE obj, size_t heap_id)
+{
+    zweak *weak = zweak_new((void *)obj);
+    rb_native_mutex_lock(&registry->lock);
+    if (registry->len == registry->capa) {
+        if (!registry->iterating) registry_compact(registry);
+        if (registry->len >= registry->capa / 2) {
+            size_t capa = registry->capa ? registry->capa * 2 : 1024;
+            struct filc_registry_entry *items = realloc(registry->items, capa * sizeof(*items));
+            if (!items) {
+                rb_native_mutex_unlock(&registry->lock);
+                rb_memerror();
+            }
+            registry->capa = capa;
+            registry->items = items;
+        }
+    }
+    registry->items[registry->len++] = (struct filc_registry_entry){weak, registry->disabled ? obj : 0, heap_id};
+    registry->allocated[heap_id]++;
+    rb_native_mutex_unlock(&registry->lock);
+}
+
+static void
+registry_stats(struct filc_registry *registry, size_t *allocated, size_t *live)
+{
+    rb_native_mutex_lock(&registry->lock);
+    memcpy(allocated, registry->allocated, sizeof(registry->allocated));
+    if (live) {
+        memset(live, 0, sizeof(registry->allocated));
+        for (size_t i = 0; i < registry->len; i++) {
+            if (zweak_get(registry->items[i].weak)) live[registry->items[i].heap_id]++;
+        }
+    }
+    rb_native_mutex_unlock(&registry->lock);
+}
+
+static void
+registry_update_gc_count(struct filc_registry *registry)
+{
+    zgc_cycle_number completed = zgc_completed_cycle();
+    if (!registry->disabled) {
+        registry->gc_count += completed - registry->counted_cycle;
+    }
+    else {
+        zgc_cycle_number previous = 0;
+        for (struct filc_gc_request *request = registry->requests; request; request = request->next) {
+            if (request->cycle > registry->counted_cycle && request->cycle <= completed && request->cycle != previous) {
+                registry->gc_count++;
+                previous = request->cycle;
+            }
+        }
+    }
+    registry->counted_cycle = completed;
+}
+
+static void
+registry_set_retained(struct filc_registry *registry, bool retained)
+{
+    for (size_t i = 0; i < registry->len; i++) {
+        registry->items[i].retained = retained ? (VALUE)zweak_get(registry->items[i].weak) : 0;
+    }
+}
+
+static void
+registry_set_disabled(struct filc_registry *registry, bool disabled)
+{
+    rb_native_mutex_lock(&registry->lock);
+    registry_update_gc_count(registry);
+    if (registry->disabled != disabled) {
+        registry->disabled = disabled;
+        registry_set_retained(registry, disabled && !registry->requests);
+    }
+    rb_native_mutex_unlock(&registry->lock);
+}
+
+static void
+registry_collect(struct filc_registry *registry)
+{
+    struct filc_gc_request request;
+    rb_native_mutex_lock(&registry->lock);
+    registry_update_gc_count(registry);
+    if (registry->disabled) registry_set_retained(registry, false);
+    request.cycle = zgc_request_fresh();
+    request.next = registry->requests;
+    registry->requests = &request;
+    rb_native_mutex_unlock(&registry->lock);
+
+    zgc_wait(request.cycle);
+
+    rb_native_mutex_lock(&registry->lock);
+    registry_update_gc_count(registry);
+    struct filc_gc_request **link = &registry->requests;
+    while (*link != &request) link = &(*link)->next;
+    *link = request.next;
+    if (registry->disabled && !registry->requests) registry_set_retained(registry, true);
+    rb_native_mutex_unlock(&registry->lock);
+}
+
+static VALUE
+registry_at(struct filc_registry *registry, size_t i)
+{
+    rb_native_mutex_lock(&registry->lock);
+    VALUE obj = (VALUE)zweak_get(registry->items[i].weak);
+    rb_native_mutex_unlock(&registry->lock);
+    return obj;
+}
+
+struct registry_each_args {
+    struct filc_registry *registry;
+    bool (*func)(VALUE obj, void *data);
+    void *data;
+    size_t limit;
+};
+
+static VALUE
+registry_each_body(VALUE ptr)
+{
+    struct registry_each_args *args = (struct registry_each_args *)ptr;
+    for (size_t i = 0; i < args->limit; i++) {
+        VALUE obj = registry_at(args->registry, i);
+        if (obj && args->func(obj, args->data)) break;
+    }
+    return Qnil;
+}
+
+static VALUE
+registry_each_ensure(VALUE ptr)
+{
+    struct filc_registry *registry = ((struct registry_each_args *)ptr)->registry;
+    rb_native_mutex_lock(&registry->lock);
+    registry->iterating--;
+    rb_native_mutex_unlock(&registry->lock);
+    return Qnil;
+}
+
+static void
+registry_each(struct filc_registry *registry, bool (*func)(VALUE obj, void *data), void *data)
+{
+    struct registry_each_args args = { registry, func, data, 0 };
+    rb_native_mutex_lock(&registry->lock);
+    args.limit = registry->len;
+    registry->iterating++;
+    rb_native_mutex_unlock(&registry->lock);
+    rb_ensure(registry_each_body, (VALUE)&args, registry_each_ensure, (VALUE)&args);
+}
+
+static bool
+prepare_heap_i(VALUE obj, void *data)
+{
+    rb_gc_prepare_heap_process_object(obj);
+    return false;
+}
