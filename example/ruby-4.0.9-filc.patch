+struct each_objects_args {
+    int (*callback)(void *, void *, size_t, void *);
+    void *data;
+};
+
+static bool
+each_objects_i(VALUE obj, void *ptr)
+{
+    struct each_objects_args *args = ptr;
+    size_t slot_size = rb_gc_impl_obj_slot_size(obj);
+    return args->callback((void *)obj, (char *)obj + slot_size, slot_size, args->data) != 0;
+}
+
+void
+rb_gc_impl_each_objects(void *objspace_ptr, int (*callback)(void *, void *, size_t, void *), void *data)
+{
+    struct each_objects_args args = { callback, data };
+    registry_each(&((struct objspace *)objspace_ptr)->registry, each_objects_i, &args);
+}
+
+struct each_object_args {
+    void (*func)(VALUE obj, void *data);
+    void *data;
+};
+
+static bool
+each_object_i(VALUE obj, void *ptr)
+{
+    struct each_object_args *args = ptr;
+    args->func(obj, args->data);
+    return false;
+}
+
+void
+rb_gc_impl_each_object(void *objspace_ptr, void (*func)(VALUE obj, void *data), void *data)
+{
+    struct each_object_args args = { func, data };
