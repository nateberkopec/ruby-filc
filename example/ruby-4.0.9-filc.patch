+static void
+maybe_schedule_finalizers(struct objspace *objspace)
+{
+    if (RUBY_ATOMIC_LOAD(objspace->finalizing)) return;
+    zgc_cycle_number completed = zgc_completed_cycle();
+    if (completed <= objspace->seen_cycle) return;
+
+    rb_native_mutex_lock(&objspace->registry.lock);
+    if (completed > objspace->seen_cycle) {
+        if (!objspace->pending_object) objspace->pending_object = (VALUE)zgc_finq_poll(objspace->object_queue);
+        if (!objspace->pending_finalizer) objspace->pending_finalizer = zgc_finq_poll(objspace->finalizer_queue);
+        objspace->seen_cycle = completed;
+        if (objspace->pending_object || objspace->pending_finalizer) {
+            rb_postponed_job_trigger(objspace->finalizer_postponed_job);
+        }
+    }
+    rb_native_mutex_unlock(&objspace->registry.lock);
+}
+
+void
+rb_gc_impl_start(void *objspace_ptr, bool full_mark, bool immediate_mark, bool immediate_sweep, bool compact)
+{
+    struct objspace *objspace = objspace_ptr;
+    if (full_mark && immediate_sweep) registry_trim(&objspace->registry);
+    registry_collect(&objspace->registry);
+    maybe_schedule_finalizers(objspace);
+    if (full_mark && immediate_sweep) zscavenge_synchronously();
+}
