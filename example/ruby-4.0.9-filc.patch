+struct rb_gc_object_metadata_entry *
+rb_gc_impl_object_metadata(void *objspace_ptr, VALUE obj)
+{
+    size_t n = 0;
+
+    if (rb_obj_id_p(obj)) {
+        object_metadata_entries[n].name = rb_intern("object_id");
+        object_metadata_entries[n].val = rb_obj_id(obj);
+        n++;
+    }
+    if (FL_TEST(obj, FL_SHAREABLE)) {
+        object_metadata_entries[n].name = rb_intern("shareable");
+        object_metadata_entries[n].val = Qtrue;
+        n++;
+    }
+    object_metadata_entries[n].name = 0;
+    object_metadata_entries[n].val = 0;
+
+    return object_metadata_entries;
+}
