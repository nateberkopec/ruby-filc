+}
+
+static VALUE
+gc_run_finalizers_get_final(long i, void *data)
+{
+    return RARRAY_AREF((VALUE)data, i + 1);
+}
+
+static bool
+finalize_box(struct filc_final_box *box)
+{
+    VALUE table = box->table;
+    if (NIL_P(table)) return false;
+    box->table = Qnil;
+    rb_gc_run_obj_finalizer(RARRAY_AREF(table, 0), RARRAY_LEN(table) - 1,
+                            gc_run_finalizers_get_final, (void *)table);
+    return true;
+}
+
+static void
+finalize_object(VALUE obj)
+{
+    if (BUILTIN_TYPE(obj) == T_FILE) {
+        struct rb_io *fptr = RFILE(obj)->fptr;
+        RFILE(obj)->fptr = NULL;
+        if (fptr) rb_io_fptr_finalize(fptr);
+    }
+    else {
+        rb_data_free(rb_gc_get_objspace(), obj);
+    }
+}
+
+static void
+gc_run_finalizers(void *data)
+{
+    struct objspace *objspace = data;
+    struct filc_final_box *box;
+
+    if (RUBY_ATOMIC_EXCHANGE(objspace->finalizing, 1)) return;
+    rb_gc_set_pending_interrupt();
+    VALUE obj, *dead = NULL;
+    size_t len = 0, capa = 0;
+
+    rb_native_mutex_lock(&objspace->registry.lock);
+    obj = objspace->pending_object;
+    box = objspace->pending_finalizer;
+    objspace->pending_object = 0;
+    objspace->pending_finalizer = NULL;
+    rb_native_mutex_unlock(&objspace->registry.lock);
+
+    while (obj || (obj = (VALUE)zgc_finq_poll(objspace->object_queue))) {
+        if (len == capa) dead = realloc(dead, (capa = capa ? capa * 2 : 256) * sizeof(VALUE));
+        dead[len++] = obj;
+        obj = 0;
+    }
+    while (box || (box = zgc_finq_poll(objspace->finalizer_queue))) {
+        finalize_box(box);
+        box = NULL;
+    }
+    for (size_t i = 0; i < len; i++) {
+        finalize_object(dead[i]);
+    }
+    free(dead);
+    rb_gc_unset_pending_interrupt();
+    RUBY_ATOMIC_SET(objspace->finalizing, 0);
+}
+
+void
+rb_gc_impl_make_zombie(void *objspace_ptr, VALUE obj, void (*dfree)(void *), void *data)
+{
+    if (dfree) dfree(data);
+}
+
+VALUE
+rb_gc_impl_define_finalizer(void *objspace_ptr, VALUE obj, VALUE block)
+{
+    struct objspace *objspace = objspace_ptr;
+
+    RBASIC(obj)->flags |= FL_FINALIZE;
+
+    int lev = RB_GC_VM_LOCK();
+    struct filc_final_box *box = final_box_for(objspace, obj);
+    VALUE table = box->table;
+
+    if (!NIL_P(table)) {
+        long len = RARRAY_LEN(table);
+        for (long i = 1; i < len; i++) {
+            VALUE recv = RARRAY_AREF(table, i);
+            if (rb_equal(recv, block)) {
+                RB_GC_VM_UNLOCK(lev);
+                return recv;
+            }
+        }
+        rb_ary_push(table, block);
+    }
+    else {
+        table = rb_ary_new3(2, rb_obj_id(obj), block);
+        rb_obj_hide(table);
+        box->table = table;
+    }
+
+    RB_GC_VM_UNLOCK(lev);
+
+    return block;
+}
+
+void
+rb_gc_impl_undefine_finalizer(void *objspace_ptr, VALUE obj)
+{
+    struct filc_final_box *box = object_fields(obj)->finalizer;
+
+    if (box) box->table = Qnil;
+    FL_UNSET(obj, FL_FINALIZE);
+}
+
+void
+rb_gc_impl_copy_finalizer(void *objspace_ptr, VALUE dest, VALUE obj)
+{
+    struct objspace *objspace = objspace_ptr;
+
+    if (!FL_TEST(obj, FL_FINALIZE)) return;
+
+    int lev = RB_GC_VM_LOCK();
+    struct filc_final_box *box = object_fields(obj)->finalizer;
+    if (box && !NIL_P(box->table)) {
+        VALUE table = rb_ary_dup(box->table);
+        rb_obj_hide(table);
+        RARRAY_ASET(table, 0, rb_obj_id(dest));
+        final_box_for(objspace, dest)->table = table;
+        FL_SET(dest, FL_FINALIZE);
+    }
+    RB_GC_VM_UNLOCK(lev);
+}
+
+static bool
+shutdown_finalize_box_i(VALUE obj, void *data)
+{
+    struct filc_final_box *box = object_fields(obj)->finalizer;
+    if (box) *(bool *)data |= finalize_box(box);
+    return false;
+}
+
+static bool
+shutdown_finalize_i(VALUE obj, void *data)
+{
+    if (finalizable_type_p(RBASIC(obj)->flags) && rb_gc_shutdown_call_finalizer_p(obj)) finalize_object(obj);
+    return false;
+}
+
+void
+rb_gc_impl_shutdown_call_finalizer(void *objspace_ptr)
+{
+    struct objspace *objspace = objspace_ptr;
+
+    gc_run_finalizers(objspace);
+
+    if (RUBY_ATOMIC_EXCHANGE(objspace->finalizing, 1)) return;
+
+    bool finalized;
+    do {
+        finalized = false;
+        struct filc_final_box *box;
+        while ((box = zgc_finq_poll(objspace->finalizer_queue))) finalized |= finalize_box(box);
+        registry_each(&objspace->registry, shutdown_finalize_box_i, &finalized);
+    } while (finalized);
+
+    VALUE obj;
+    while ((obj = (VALUE)zgc_finq_poll(objspace->object_queue))) finalize_object(obj);
+    registry_each(&objspace->registry, shutdown_finalize_i, NULL);
+
+    RUBY_ATOMIC_SET(objspace->finalizing, 0);
+}
+
+void
+rb_gc_impl_before_fork(void *objspace_ptr)
+{
+    struct objspace *objspace = objspace_ptr;
+    objspace->fork_vm_lock_lev = RB_GC_VM_LOCK();
+    rb_gc_vm_barrier();
+    rb_native_mutex_lock(&objspace->registry.lock);
+}
+
+void
+rb_gc_impl_after_fork(void *objspace_ptr, rb_pid_t pid)
+{
+    struct objspace *objspace = objspace_ptr;
+    rb_native_mutex_unlock(&objspace->registry.lock);
+    RB_GC_VM_UNLOCK(objspace->fork_vm_lock_lev);
+    objspace->fork_vm_lock_lev = 0;
+}
+
