+unsigned long long rb_gc_impl_get_total_time(void *objspace_ptr) { return 0; }
+
+size_t
+rb_gc_impl_gc_count(void *objspace_ptr)
+{
+    struct filc_registry *registry = &((struct objspace *)objspace_ptr)->registry;
+    rb_native_mutex_lock(&registry->lock);
+    registry_update_gc_count(registry);
+    size_t count = registry->gc_count;
+    rb_native_mutex_unlock(&registry->lock);
+    return count;
+}
+
+VALUE
+rb_gc_impl_latest_gc_info(void *objspace_ptr, VALUE hash_or_key)
+{
+    VALUE hash = Qnil, key = Qnil;
+
+    if (SYMBOL_P(hash_or_key)) {
+        key = hash_or_key;
+    }
+    else if (RB_TYPE_P(hash_or_key, T_HASH)) {
+        hash = hash_or_key;
+    }
+    else {
+        rb_bug("gc_info_decode: non-hash or symbol given");
+    }
+
+    VALUE state = ID2SYM(rb_intern_const("state"));
+    VALUE none = ID2SYM(rb_intern_const("none"));
+    if (key == state) return none;
+    if (!NIL_P(hash)) rb_hash_aset(hash, state, none);
+    if (!NIL_P(key)) return Qundef;
+
+    return hash;
+}
+
+VALUE
+rb_gc_impl_stat(void *objspace_ptr, VALUE hash_or_sym)
+{
+    struct objspace *objspace = objspace_ptr;
+    VALUE hash = Qnil, key = Qnil;
+
+    if (RB_TYPE_P(hash_or_sym, T_HASH)) {
+        hash = hash_or_sym;
+    }
+    else if (SYMBOL_P(hash_or_sym)) {
+        key = hash_or_sym;
+    }
+    else {
+        rb_bug("non-hash or symbol given");
+    }
+
+#define SET(name, attr) do { \
+        VALUE sym = ID2SYM(rb_intern_const(#name)); \
+        if (key == sym) return SIZET2NUM(attr); \
+        if (!NIL_P(hash)) rb_hash_aset(hash, sym, SIZET2NUM(attr)); \
+    } while (0)
+
+    size_t count = rb_gc_impl_gc_count(objspace);
+    SET(count, count);
+    SET(time, 0);
+    SET(major_gc_count, count);
+    SET(minor_gc_count, 0);
+    SET(heap_free_slots, 0);
+
+    size_t allocated[FILC_HEAP_COUNT], live[FILC_HEAP_COUNT] = {0};
+    registry_stats(&objspace->registry, allocated, key == sym("total_allocated_objects") ? NULL : live);
+    size_t total_allocated = 0, total_live = 0;
+    for (size_t i = 0; i < FILC_HEAP_COUNT; i++) {
+        total_allocated += allocated[i];
+        total_live += live[i];
+    }
+    SET(total_allocated_objects, total_allocated);
+    SET(total_freed_objects, total_allocated - total_live);
+    SET(heap_live_slots, total_live);
+#undef SET
+
+    if (!NIL_P(key)) return Qundef;
+
+    return hash;
+}
+
+static VALUE
+stat_one_heap(size_t heap_id, size_t allocated, size_t live, VALUE hash_or_sym)
+{
+    VALUE key = SYMBOL_P(hash_or_sym) ? hash_or_sym : Qnil;
+#define SET(name, value) do { \
+        VALUE stat = sym(#name); \
+        if (key == stat) return SIZET2NUM(value); \
+        if (NIL_P(key)) rb_hash_aset(hash_or_sym, stat, SIZET2NUM(value)); \
+    } while (0)
+    SET(slot_size, heap_sizes[heap_id]);
+    SET(heap_live_slots, live);
+    SET(heap_free_slots, 0);
+    SET(total_allocated_objects, allocated);
+    SET(total_freed_objects, allocated - live);
+#undef SET
+    return NIL_P(key) ? hash_or_sym : Qundef;
+}
+
+VALUE
+rb_gc_impl_stat_heap(void *objspace_ptr, VALUE heap_name, VALUE hash_or_sym)
+{
+    struct objspace *objspace = objspace_ptr;
+    long heap_id = NIL_P(heap_name) ? -1 : FIX2LONG(heap_name);
+    if (!NIL_P(heap_name) && (heap_id < 0 || heap_id >= FILC_HEAP_COUNT)) {
+        rb_raise(rb_eArgError, "size pool index out of range");
+    }
+
+    VALUE hashes[FILC_HEAP_COUNT];
+    if (NIL_P(heap_name)) {
+        for (size_t i = 0; i < FILC_HEAP_COUNT; i++) {
+            hashes[i] = rb_hash_aref(hash_or_sym, SIZET2NUM(i));
+            if (NIL_P(hashes[i])) {
+                hashes[i] = rb_hash_new();
+                rb_hash_aset(hash_or_sym, SIZET2NUM(i), hashes[i]);
+            }
+        }
+    }
+
+    size_t allocated[FILC_HEAP_COUNT], live[FILC_HEAP_COUNT];
+    registry_stats(&objspace->registry, allocated, live);
+    if (!NIL_P(heap_name)) return stat_one_heap(heap_id, allocated[heap_id], live[heap_id], hash_or_sym);
+    for (size_t i = 0; i < FILC_HEAP_COUNT; i++) {
+        stat_one_heap(i, allocated[i], live[i], hashes[i]);
+    }
+    return hash_or_sym;
+}
+
