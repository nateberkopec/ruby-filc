+VALUE
+rb_gc_impl_new_obj(void *objspace_ptr, void *cache_ptr, VALUE klass, uintptr_t flags, bool wb_protected, size_t alloc_size)
+{
+    struct objspace *objspace = objspace_ptr;
+
+    size_t heap_id = rb_gc_impl_heap_id_for_size(objspace, alloc_size);
+    alloc_size = heap_sizes[heap_id];
+
+    stress_collect(objspace);
+    maybe_schedule_finalizers(objspace);
+
+    size_t malloc_size = alloc_size + sizeof(struct filc_object_fields);
+    struct RBasic *obj = finalizable_type_p(flags) ? zgc_finq_alloc(objspace->object_queue, malloc_size) : malloc(malloc_size);
+    obj->flags = flags;
+    *(VALUE *)&obj->klass = klass;
+    *object_fields((VALUE)obj) = (struct filc_object_fields){0};
+#if RACTOR_CHECK_MODE
+    void rb_ractor_setup_belonging(VALUE obj);
+    rb_ractor_setup_belonging((VALUE)obj);
+#endif
+
+    registry_add(&objspace->registry, (VALUE)obj, heap_id);
+
+    return (VALUE)obj;
+}
+
+size_t
+rb_gc_impl_obj_slot_size(VALUE obj)
+{
+    size_t capacity = (char *)zgetupper((void *)obj) - (char *)obj;
+    for (int i = FILC_HEAP_COUNT - 1; i >= 0; i--) {
+        if (heap_sizes[i] <= capacity) return heap_sizes[i];
+    }
+    rb_bug("object smaller than the smallest heap slot");
+}
+
+size_t
+rb_gc_impl_heap_id_for_size(void *objspace_ptr, size_t size)
+{
+    for (int i = 0; i < FILC_HEAP_COUNT; i++) {
+        if (size <= heap_sizes[i]) return i;
+    }
+    rb_bug("size too big");
+}
+
+bool
+rb_gc_impl_size_allocatable_p(size_t size)
+{
+    return size <= FILC_MAX_OBJ_SIZE;
+}
